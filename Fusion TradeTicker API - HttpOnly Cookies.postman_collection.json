          "name": "Create Trade",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trade created', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const json = pm.response.json();",
                  "const trade = json.data || json;",
                  "if (trade && trade.id) pm.collectionVariables.set('trade_id', trade.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
