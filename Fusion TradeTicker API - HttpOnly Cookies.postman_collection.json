{
  "info": {
    "_postman_id": "82d605ac-0dc9-418b-8c76-9d1285ef5e5a",
    "name": "Fusion TradeTicker API - HttpOnly Cookies",
    "description": "HttpOnly-cookie authentication collection. Login stores access_token and refresh_token in Postman's cookie jar via Set-Cookie headers. Protected requests use those cookies automatically; no Bearer token variables are required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "20610249"
  },
