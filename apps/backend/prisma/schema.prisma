generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TRADER
  ADMIN
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  ACTIVE
  CANCELLED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  name          String
  password_hash String
  role          UserRole @default(TRADER)

  trades Trade[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([email])
  @@index([username])

  @@map("users")
}

model Trade {
  id       String    @id @default(uuid())
  symbol   String
  side     TradeSide
  quantity Int
  price    Decimal   @db.Decimal(18, 4)

  trader_id String
  trader User @relation(fields: [trader_id], references: [id])
  book         String
  counterparty String

  trade_timestamp DateTime

  status TradeStatus @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([symbol])
  @@index([trader_id])
  @@index([status])
  @@index([trade_timestamp])

  @@map("trades")
}